@page "/inventories"
@using IMS.WebApp.Components.Controls

<h3>Inventory List</h3>

<br />

<SearchFilterComponent SearchFilterChanged="HandleSearchFilterChanged"></SearchFilterComponent>

<br />

<InventoryListComponent SearchInventoryFilter="@searchInventoryFilter"></InventoryListComponent>

<br />

<a href="./addInventory" class="btn btn-primary" >Add Inventory</a>

@code {

    private string? searchInventoryFilter;

    private async Task HandleSearchFilterChanged(string? filter)
    {
        searchInventoryFilter = filter;
    }
}