@page "/products"
@using IMS.WebApp.Components.Controls

<h3>Product List</h3>

<br />

<SearchFilterComponent SearchFilterChanged="HandleSearchFilterChanged"></SearchFilterComponent>

<br />

<ProductListComponent SearchProductFilter="@searchProductFilter"></ProductListComponent>

<br />

<a class="btn btn-success" href="./addProduct">
    Add Product
</a>

@code {

    private string? searchProductFilter;

    private async Task HandleSearchFilterChanged(string? filter)
    {
        searchProductFilter = filter;
    }
}
