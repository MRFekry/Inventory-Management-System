@inject IDeleteProductUseCase DeleteProductUseCase

@if (Product != null)
{
    <tr>
        <td>@Product.Name</td>
        <td>@Product.Quantity</td>
        <td>@Product.Price.ToString("C")</td>
        <td>
            <a class="btn btn-primary" href="@($"/products/edit/{Product.Id}")">
                Edit
            </a>
        </td>
        <td>
            <EditForm 
                Enhance="true" 
                FormName="@($"DeleteProductForm-{Product.Id}")" 
                Model="Product" >
                <button class="btn btn-danger" type="button" @onclick="async () => { await DeleteProduct(Product.Id); }">
                    Delete
                </button>
            </EditForm>
        </td>
    </tr>
}

@code {
    [Parameter]
    public Product? Product { get; set; }

    private async Task DeleteProduct(int productId)
    {
        await DeleteProductUseCase.ExecuteAsync(productId);
        Product = null;
    }
}
