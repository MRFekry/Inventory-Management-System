@inject NavigationManager NavigationManager
@inject IDeleteInventoryUseCase DeleteInventoryUseCase

@if (Inventory != null)
{
    <tr>
        <td>@Inventory.Name</td>
        <td>@Inventory.Quantity</td>
        <td>@Inventory.Price.ToString("C")</td>
        <td>
            <a class="btn btn-primary" href="/editInventory/@Inventory.Id">
                Edit
            </a>
        </td>
        <td>
            <EditForm FormName="@($"DeleteInventoryForm-{Inventory.Id}")" Model="Inventory" OnValidSubmit="() => DeleteInventory(Inventory.Id)">
                <button class="btn btn-danger" type="submit">
                    Delete
                </button>
            </EditForm>            
        </td>
    </tr>
}

@code {
    [Parameter]
    public Inventory? Inventory { get; set; }

    private void EditInventory()
    {
        // Handle edit inventory logic
        NavigationManager.NavigateTo("/editInventory");
    }

    private void DeleteInventory(int inventoryId)
    {
        // Handle delete inventory logic
        DeleteInventoryUseCase.ExecuteAsync(inventoryId);
        NavigationManager.Refresh();
    }
}
